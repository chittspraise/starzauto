# Copy this file to .env.local and fill in real values.

# Password for the dealer admin at /admin
ADMIN_PASSWORD=change-me

# Random string (32+ chars) used to sign admin login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only admin key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp number with country code (digits only), e.g. 263771234567.
# Shows "Chat on WhatsApp" buttons and receives enquiry alerts.
WHATSAPP_NUMBER=
# CallMeBot API key for enquiry alerts to WhatsApp (https://www.callmebot.com). Optional.
CALLMEBOT_API_KEY=
